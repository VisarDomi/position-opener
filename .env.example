APP_PROFILE=personal
PUBLIC_API_KEY=api-key-here
PUBLIC_IDENTIFIER=api-identifier-here
PUBLIC_PASSWORD=api-password-here
SHOWCASE_API_KEY=showcase-api-key-here
SHOWCASE_IDENTIFIER=showcase-identifier-here
SHOWCASE_PASSWORD=showcase-password-here
# HTTP Basic auth for the personal profile. Generate an entry with:
#   npm run auth:hash -- <username>
# Comma-separate multiple entries. Unset in the personal profile, the app refuses
# to serve (503); the showcase profile ignores this and stays public.
AUTH_USERS=
